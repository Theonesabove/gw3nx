+// Horizon: code is written through an RW alias and executed from an RX alias (libnx Jit, CodeMemory mode).
+// The kernel has few CodeMemory objects to hand out, so every CodeBlock is a slice of one shared pool.
+#include <switch.h>
+#include <cstdio>
+#include <mutex>
+namespace oaknut {
+class CodeBlock {
+public:
+    static constexpr std::size_t POOL_SIZE = 448u << 20;
+    explicit CodeBlock(std::size_t size)
+    {
+        static Jit pool;
+        static std::size_t used = 0;
+        static std::mutex mx;
+        std::lock_guard<std::mutex> lk(mx);
+        if (!used) {
+            Result rc = jitCreate(&pool, POOL_SIZE);
+            if (R_FAILED(rc)) {
+                fprintf(stderr, "oaknut: jitCreate(%zu MiB) failed rc=0x%x\n", POOL_SIZE >> 20, rc);
+                fflush(stderr);
+                throw std::bad_alloc{};
+            }
+            jitTransitionToExecutable(&pool);
+            fprintf(stderr, "oaknut: JIT pool rx=%p-%p\n", jitGetRxAddr(&pool), (char*)jitGetRxAddr(&pool) + POOL_SIZE);
+            used = 0x1000;  // keep offset 0 free so "used == 0" means uninitialised
+        }
+        size = (size + 0xFFF) & ~std::size_t(0xFFF);
+        if (used + size > POOL_SIZE) {
+            fprintf(stderr, "oaknut: JIT pool exhausted (%zu MiB used, %zu KiB more requested)\n", used >> 20, size >> 10);
+            fflush(stderr);
+            throw std::bad_alloc{};
+        }
+        m_rw = (std::uint8_t*)jitGetRwAddr(&pool) + used;
+        m_rx = (std::uint8_t*)jitGetRxAddr(&pool) + used;
+        m_size = size;
+        used += size;  // ponytail: slices are never returned (JITs live as long as their thread)
+    }
+    CodeBlock(const CodeBlock&) = delete;
+    CodeBlock& operator=(const CodeBlock&) = delete;
+    std::uint32_t* ptr() const { return (std::uint32_t*)m_rx; }
+    std::uint32_t* wptr() const { return (std::uint32_t*)m_rw; }
+    void protect() {}
+    void unprotect() {}
+    void invalidate(std::uint32_t* mem, std::size_t size)
+    {
+        armDCacheFlush(m_rw + ((std::uint8_t*)mem - m_rx), size);
+        armICacheInvalidate(mem, size);
+    }
+    void invalidate_all() { invalidate(ptr(), m_size); }
+private:
+    std::uint8_t* m_rw;
+    std::uint8_t* m_rx;
+    std::size_t m_size;
+};
+}  // namespace oaknut
